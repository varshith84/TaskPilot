# =============================================================================
# TaskPilot Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Application
APP_NAME=TaskPilot
APP_ENV=development

# Google Gemini (required when AI chat features are used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tavily web search (required when live web search is used)
TAVILY_API_KEY=

# Storage paths (defaults work out of the box; adjust if needed)
VECTOR_STORE_PATH=../data/vector_store
UPLOAD_DIR=../data/uploads

# Database (SQLite by default; adjust for PostgreSQL in production)
DATABASE_URL=sqlite:///./taskpilot.db

# CORS — must match the frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# File upload limit (MB)
MAX_UPLOAD_SIZE_MB=20

# RAG parameters
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
