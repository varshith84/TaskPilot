# =============================================================================
# TaskPilot — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# Virtual environments
.venv/
.venv_new/
backend/.venv/
backend/.venv_new/
venv/
env/
ENV/
.env.bak

# Pytest / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.lcov
nosetests.xml

# MyPy / type checking
.mypy_cache/
.dmypy.json

# Ruff / linting
.ruff_cache/

# ---------------------------------------------------------------------------
# Environment files — NEVER commit secrets
# ---------------------------------------------------------------------------
.env
backend/.env
frontend/.env

# Allow the examples (they contain no secrets)
!.env.example
!backend/.env.example
!frontend/.env.example

# ---------------------------------------------------------------------------
# Node / Frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Data directories — uploaded files and AI indexes are never committed
# ---------------------------------------------------------------------------
data/uploads/*
data/vector_store/*

# Keep the placeholder files so directories remain visible in Git
!data/uploads/.gitkeep
!data/vector_store/.gitkeep

# SQLite databases
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ---------------------------------------------------------------------------
# IDE / OS noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# JetBrains IDEs
.idea/
*.iml

# VS Code
.vscode/
*.code-workspace

# Vim
*.swp
*.swo

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
